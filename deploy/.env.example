# Local-first Hermes WebUI admin console
# Copy to deploy/.env and keep secrets out of git.

HOST_HERMES_HOME=/home/hermes/.hermes
HOST_WORKSPACE=/workspace/live-hermes
HOST_REPOS=/opt/hermes-webui/repos
HOST_CONFIGS=/opt/hermes-webui/configs
HOST_SECRETS=/opt/hermes-webui/secrets
HOST_BACKUPS=/opt/hermes-webui/backups
HOST_AUDIT=/opt/hermes-webui/audit
HOST_RELEASES=/opt/hermes-webui/releases
HOST_LOGS=/opt/hermes-webui/logs
HOST_DEPLOY=/opt/hermes-webui

HERMES_WEBUI_PORT=8787
HERMES_WEBUI_IMAGE=hermes-webui:prod
ENABLE_HINDSIGHT=false
HERMES_WEBUI_AGENT_DIR=/opt/hermes-admin/hermes-home/hermes-agent

# Optional future fallback, keep disabled unless explicitly approved.
# HINDSIGHT_CLIENT_REQUIREMENT=hindsight-client==0.7.2
